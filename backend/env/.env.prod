# ==================================
# 生产环境配置文件
# ==================================

ENVIRONMENT = prod

# 服务器配置
SERVER_HOST = 0.0.0.0
SERVER_PORT = 8001

# 文档配置
DEBUG = False
VERSION = 3.1.0

# 是否启用演示模式
DEMO_ENABLE = True

# 数据库配置：mysql-3306、postgres-5432、sqlite
DATABASE_TYPE = mysql
DATABASE_HOST = 172.18.52.77
DATABASE_PORT = 3306
DATABASE_USER = root
DATABASE_PASSWORD = xxxx
DATABASE_NAME = fastapiadmin

# Redis配置
REDIS_HOST = 172.18.52.77
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = xxxx
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = INFO

# 大模型配置
OPENAI_BASE_URL = https://api.deepseek.com
OPENAI_API_KEY = sk-xxxx
OPENAI_MODEL = deepseek-v4-pro
